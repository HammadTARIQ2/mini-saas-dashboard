# Runtime environment: development | production | test
NODE_ENV=development

# HTTP port the API listens on
PORT=4000

# MongoDB connection string (MongoDB Atlas or local)
# e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mini-saas?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/mini-saas

# Secret used to sign JWTs — use a long random string (min 32 chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Token lifetime (jsonwebtoken / vercel-ms format, e.g. 15m, 12h, 7d)
JWT_EXPIRES_IN=1d

# Token lifetime when the user ticks "Remember me" on the login page
JWT_REMEMBER_EXPIRES_IN=30d

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
